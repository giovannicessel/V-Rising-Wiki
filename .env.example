# Google AI Studio — geração de artes (scripts/generate-wiki-art.mjs)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Intervalo entre imagens (ms) — evita 429 / rate limit. Padrão: 8000 (~7 img/min)
GOOGLE_AI_DELAY_MS=8000

# Modelo com saída de imagem (ver https://ai.google.dev/gemini-api/docs/image-generation)
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# Tradução de textos da wiki para pt-BR (scripts/translate-content-pt.mjs)
GOOGLE_TEXT_MODEL=gemini-2.0-flash
GOOGLE_TRANSLATE_BATCH=2
GOOGLE_TRANSLATE_DELAY_MS=2500
